# ─── Aplicación ───────────────────────────────────────────────────────────
APP_NAME=Gestor de Documentos de Proyectos
APP_VERSION=1.0.0
DEBUG=false

# ─── Seguridad (CAMBIAR en producción) ────────────────────────────────────
# Generar con: openssl rand -hex 32
SECRET_KEY=cambiar-por-un-secret-key-seguro-de-al-menos-32-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Contraseña inicial del super administrador (solo seed). Cámbiela antes de usar.
ADMIN_PASSWORD=cambiar-esta-clave
ADMIN_EMAIL=admin@local.test
ADMIN_NAME=Super administrador

# Roles del sistema (seed automático):
# - super_administrador: control total
# - administrador: proyectos/documentos + usuarios con rol usuario
# - usuario: solo consulta y descarga

# ─── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_USER=cargue
POSTGRES_PASSWORD=cambiar_password_postgres_seguro
POSTGRES_DB=cargue_docs
# URL interna Docker (async). No publicar el puerto al host.
DATABASE_URL=postgresql+asyncpg://cargue:cambiar_password_postgres_seguro@db:5432/cargue_docs

# ─── Almacenamiento ───────────────────────────────────────────────────────
STORAGE_PATH=/storage/uploads
MAX_FILE_SIZE_MB=50
BPIN_MIN_LENGTH=5
BPIN_MAX_LENGTH=50

# ─── CORS / Frontend ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
PUBLIC_URL=http://localhost:8080

# ─── Rate limiting login ──────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
